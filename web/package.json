    "viem": "2.38.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.0.4",
    "playwright": "1.56.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.1.10"
  }
